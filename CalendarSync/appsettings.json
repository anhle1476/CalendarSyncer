{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Google": {
    "ServiceAccountKeyPath": "",
    "CalendarId": "primary"
  },
  "Database": {
    "ConnectionString": "Server=your_server;Database=CalendarDB;Trusted_Connection=True;"
  },
  "Sync": {
    "NormalPollingIntervalMinutes": 30,
    "FallbackPollingIntervalMinutes": 5
  },
  "Notification": {
    "UdpHost": "127.0.0.1",
    "UdpPort": 11004
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "calendar_exchange",
    "QueueName": "calendar_events",
    "RoutingKey": "calendar.event",
    "Durable": true,
    "ConnectionTimeoutSeconds": 30,
    "HeartbeatSeconds": 60
  },
  "Webhook": {
    "Enabled": true,
    "ServiceUrl": "http://localhost:3000",
    "HealthCheckEndpoint": "/health",
    "HealthCheckIntervalSeconds": 30,
    "TimeoutSeconds": 10,
    "FallbackToPolling": true,
    "DebounceDelayMs": 2000
  },
  "Mode": "Webhook"
}
